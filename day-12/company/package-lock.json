{
  "name": "company",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "company",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/admin": {
      "version": "1.0.0",
      "dependencies": {
        "@company/ui": "*"
      }
    },
    "apps/website": {
      "version": "1.0.0",
      "dependencies": {
        "@company/ui": "*"
      }
    },
    "node_modules/@company/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/admin": {
      "resolved": "apps/admin",
      "link": true
    },
    "node_modules/website": {
      "resolved": "apps/website",
      "link": true
    },
    "packages/ui": {
      "name": "@company/ui",
      "version": "1.0.0"
    }
  }
}
